---
import DescargarPdf from "./DescargarPdf.astro";

interface Props {
  kicker: string;
  numero: string;
  tituloHtml: string;
  subtitulo: string;
  pdf?: boolean;
}

const { kicker, numero, tituloHtml, subtitulo, pdf = false } = Astro.props;
---

<header class="hero">
  <p class="teorico">{kicker}</p>
  <p class="num" aria-hidden="true">{numero}</p>
  <h1 set:html={tituloHtml} />
  <p>{subtitulo}</p>
  {pdf && <DescargarPdf />}
</header>
