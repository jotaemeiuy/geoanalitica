---
import CalculatorShell from "../CalculatorShell.astro";
---

<CalculatorShell titulo="Calcular punto medio" id="calc-medio">
  <form data-calc="medio">
    <div class="inputs">
      <label>x₁<input type="number" name="x1" value="1" required /></label>
      <label>y₁<input type="number" name="y1" value="2" required /></label>
      <label>x₂<input type="number" name="x2" value="5" required /></label>
      <label>y₂<input type="number" name="y2" value="6" required /></label>
      <button type="submit">Calcular</button>
    </div>
    <output data-result aria-live="polite">M = …</output>
  </form>
</CalculatorShell>

<script>
  const form = document.querySelector<HTMLFormElement>('form[data-calc="medio"]');
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const v = (n: string) => Number((form.elements.namedItem(n) as HTMLInputElement).value);
    const out = form.querySelector<HTMLOutputElement>("[data-result]");
    if (out) out.textContent = `M = (${(v("x1") + v("x2")) / 2}, ${(v("y1") + v("y2")) / 2})`;
  });
</script>
